
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Source code checked out from GitHub'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker --version'
                bat 'docker build -t devops-cicd-app .'
            }
        }
        stage('Test'){
            steps {
                bat'docker run -d --name test-container -p 8082:80 devops-cicd-app'
                bat 'powershell -Command "try { $response = Invoke-WebRequest -Uri http://localhost:8082 -UseBasicParsing; if ($response.StatusCode -ne 200) { exit 1 } } catch { exit 1 }"'
                bat 'docker stop test-container'
                bat 'docker rm test-container'
                }

            }
            
        stage('Deploy to EC2') {
             steps {
                 withCredentials([
                     file(
                        credentialsId: 'ec2-deploy-key',
                         variable: 'EC2_KEY'
                        )
                     ]) {
                        bat 'whoami'
                        bat 'icacls "%EC2_KEY%" /inheritance:r'
                        bat 'icacls "%EC2_KEY%" /grant:r "NT AUTHORITY\\SYSTEM:R"'
                        bat '''
                             ssh -o StrictHostKeyChecking=no -i "%EC2_KEY%" ec2-user@3.106.130.132 "cd devops-ci-cd-pipeline && git pull && sudo docker build -t devops-cicd-app . && (sudo docker rm -f devops-cicd-app || true) && sudo docker run -d --name devops-cicd-app -p 80:80 devops-cicd-app"
                            '''
                    }
                }

            }
    }
}
